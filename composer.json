{
  "name": "boltuslab/laravel-query-doctor",
  "description": "A database query performance diagnostic package for Laravel.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
    "illuminate/console": "^10.0 || ^11.0 || ^12.0 || ^13.0"
  },
  "autoload": {
    "psr-4": {
      "BoltusLab\\QueryDoctor\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
        "BoltusLab\\QueryDoctor\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "BoltusLab\\QueryDoctor\\QueryDoctorServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require-dev": {
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.0"
  }
}
